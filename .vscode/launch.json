{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type":"cppvsdbg",
            "request": "launch",
            "name": "win debug",
            "program": "${workspaceFolder}/build_wind/cgn.exe",
            "cwd": "${workspaceRoot}/..",
            "console": "integratedTerminal",
            "args": ["--winenv",
                "--halt_on_error", "--scriptcc_debug",
                "--target", "msvc,debug", 
                "query", "@aert//app/nodeapp:pkg_napi10"
                // "query", "@third_party//asio:asio.git"
            ]
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "linux debug",
            "program": "${workspaceFolder}/build_linuxd/cgn",
            "cwd": "${workspaceRoot}/..",
            "args": [
                "--halt_on_error", "--scriptcc_debug", "-V",
                "--target", "llvm,debug,asan",
                "--cgn-out", "C:\\workingdir\\cgntmp",
                "query", "@aert//app/nodeapp:pkg_napi10"
                // "query", "@third_party//asio:asio.git"
            ]
        },
    ]
}
