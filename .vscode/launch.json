    "version": "0.2.0",
    "configurations": [
        {
            "type":"cppvsdbg",
            "request": "launch",
            "name": "win debug",
            "program": "${workspaceFolder}/@cgn.d/build_wind/cgn.exe",
            "cwd": "${workspaceRoot}",
            "args": ["--winenv",
                "--halt_on_error", "--scriptcc_debug", "-V",
                "--target", "msvc,debug", 
                "query", "@third_party//asio:asio.git"
            ]
        },
    ]
}
