rule quick_run
    command = ${cmd}
    description = ${desc}

rule run
    command = ${exe} ${in} ${args}
    description = ${desc}

rule run_rsp
    command = ${exe} @${out}.rsp
    description = ${desc}
    rspfile = ${out}.rsp
    rspfile_content = ${in} ${args}

rule run_input_as_rsp
    command = ${exe} @${in} ${args}
    description = ${desc}

rule unix_stamp
    command = touch ${out}
    description = STAMP ${out}

rule win_stamp
    command = cmd /c "type nul > ${out}"
    description = STAMP ${out}

rule win_run_and_stamp
    command = ${exe} ${in} ${args} && cmd /c "type nul > ${out}"
    description = ${desc}

rule unix_run_and_stamp
    command = ${exe} ${in} ${args} && touch ${out}
    description = ${desc}
