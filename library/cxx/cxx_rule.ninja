rule gcc
    command = ${cc} -MMD -MF ${out}.d ${cflags} -c ${in} -o ${out}
    description = CXX ${out}
    depfile = ${out}.d
    deps = gcc

rule msvc_cl
    command = ${cc} /nologo /showIncludes @${out}.rsp
    description = CXX ${out}
    deps = msvc
    rspfile = ${out}.rsp
    rspfile_content = ${cflags} /c ${in} /Fo"${out}" /Fd"${pdb}"

rule msvc_ml
    command = ${cc} /nologo ${cflags} /Fo ${out} ${in}

rule msvc_lib
    command = ${libexe} /nologo @${out}.rsp
    rspfile = ${out}.rsp
    rspfile_content = /OUT:${out} ${arflags} ${in}
    description = LIB ${out}

rule msvc_link
    command = ${link} /nologo @${out}.rsp
    rspfile = ${out}.rsp
    rspfile_content = /OUT:${out} ${ldflags} ${in}
    description = LINK ${out}

rule gcc_ar
    command = rm -f ${out} && ${exe} rcs ${arflags} ${out} ${in}
    description = AR ${out}

rule crun
    command = ${cmd}
    description = ${desc}

rule crun_rsp
    command = ${exe} @${out}.rsp
    description = ${desc}
    rspfile = ${out}.rsp
    rspfile_content = ${args}

## windows simple copy command
## only for copy runtime dll to exe output dir.
## for complex copy command, using advcopy instead
rule win_file_copy_cppdeprule
    command = xcopy.exe ${in} ${out} /-I /H /Y
    description = COPY ${in} => ${OUT}
    restat = 1

rule unix_file_copy_cppdeprule
    command = install ${in} ${out}
    description = COPY ${in} => ${out}
    restat = 1
